# PayPal sandbox (see SETUP_PAYPAL.md — 10 minutes)
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Created by: python tools/setup_webhook.py https://<your-ngrok-or-render-url>/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Sandbox buyer (the customer who opens the dispute).
# Used by code for the PayPal-Auth-Assertion JWT (email only). The password is
# for YOUR manual browser login during sandbox checkout — code never reads it.
PAYPAL_BUYER_EMAIL=
PAYPAL_BUYER_PASSWORD=

# Day-0 test transaction
TEST_AMOUNT=25.00
TEST_CURRENCY=USD

# App
APP_MODE=fixture            # live | fixture
DATABASE_URL=postgresql+psycopg2://proofpilot:proofpilot@localhost:5432/proofpilot

# AI (wired up Day 2)
ANTHROPIC_API_KEY=

# LLM (any OpenAI-compatible endpoint; default NVIDIA NIM free tier)
NVIDIA_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
